{
  "name": "coco-instruments",
  "version": "2.0.0",
  "description": "Coco — Telegram Mini App (finance & more)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server.js",
    "lint": "eslint .",
    "format": "prettier --write src server.js app.js tests",
    "format:check": "prettier --check src server.js app.js tests"
  },
  "dependencies": {
    "@telegram-apps/init-data-node": "^2.0.10",
    "@telegram-apps/telegram-ui": "^2.1.9",
    "@tma.js/sdk-react": "^3.0.8",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.11",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eruda": "^3.4.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
